# =====================================================================
# CLINEXA - Environment Variables Configuration Template
# Duplicate this file to .env and configure your production credentials.
# =====================================================================

# --- Application & JWT Security ---
PROJECT_NAME="CLINEXA - Health Risk Alert & Case Management System"
SECRET_KEY="clinexa_clinical_risk_jwt_secret_key_2026_super_secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_OTP="false"

# --- Relational Database (PostgreSQL) ---
# When PostgreSQL is active on port 5432, CLINEXA connects automatically.
# If PostgreSQL is not reachable, CLINEXA transparently uses database/clinexa.db (SQLite)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clinexa_db"

# --- SMS Gateway Provider Selection ---
# Options: 'auto' | 'msg91' | 'twilio'
# If credentials are not provided, CLINEXA logs dispatches in transparent Simulation Mode.
SMS_PROVIDER="auto"

# --- MSG91 Credentials (Recommended for Indian Cellular Delivery +91) ---
# Obtain from https://msg91.com/ (requires DLT registration for Indian numbers)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="CLINEX"
MSG91_TEMPLATE_ID=""

# --- Twilio Credentials (Recommended for International / US Cellular Delivery) ---
# Obtain from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
